# The apprentice dalang for Ollama: Qwen3.5-4B merged with the Tinker LoRA (apprentice/export.py).
# Chat settings copied from `ollama show qwen3.5:4b --modelfile`, so the comparison with the untrained model is fair.
# Usage, from apprentice/: ollama create bayang-apprentice -q nvfp4 -f Modelfile  (nvfp4, as qwen3.5:4b uses)
FROM ./weights/merged
TEMPLATE {{ .Prompt }}
RENDERER qwen3.5
PARSER qwen3.5
PARAMETER min_p 0
PARAMETER presence_penalty 1.5
PARAMETER repeat_penalty 1
PARAMETER top_k 20
PARAMETER top_p 0.95
