# Copy to .env and fill in. Never commit .env. Paste values right after "=", no quotes.

# fake | ollama | cloudflare
DALANG_PROVIDER=fake
# e.g. gemma4:e2b (Ollama) or @cf/google/gemma-4-26b-a4b-it (Cloudflare)
DALANG_MODEL=
OLLAMA_URL=http://localhost:11434
# Cloudflare dashboard home (not secret)
CF_ACCOUNT_ID=
# My Profile > API Tokens > "Workers AI" template (secret)
CF_API_TOKEN=
SENTRY_DSN=
# Cloudflare's free plan gives 10,000 neurons a day, about $0.11 of usage.
DALANG_DAILY_BUDGET_USD=0.10
