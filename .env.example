# Copy to .env and fill in. Never commit .env.
DALANG_PROVIDER=fake            # fake | ollama | digitalocean
DALANG_MODEL=                   # e.g. gemma4:e2b (Ollama) or the Gemma model id on DigitalOcean
OLLAMA_URL=http://localhost:11434
DO_INFERENCE_URL=               # DigitalOcean serverless inference base URL (OpenAI-compatible, ends in /v1)
DO_INFERENCE_KEY=               # your DigitalOcean model access key
SENTRY_DSN=
DALANG_DAILY_BUDGET_USD=0.50
